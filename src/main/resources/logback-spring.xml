<configuration>
  <springProperty scope="context" name="ROOT_LEVEL" source="logging.level.root" defaultValue="WARN"/>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder><pattern>%date{ISO8601} level=%level logger=%logger{40} %msg%n</pattern></encoder>
  </appender>
  <root level="${ROOT_LEVEL}"><appender-ref ref="STDERR"/></root>
</configuration>
